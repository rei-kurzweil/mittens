/target
/.games/
.vscode
vendor-openxr/

# Profiling artifacts
docs/analysis/perf.data*
docs/.debug/*.log

# Local working data (vehicle trials, caches). Not tracked.
/assets/data/

# Installed user packages (imported or received from peers). Built-in
# packages live in packages/system and are tracked.
/packages/user/**
!/packages/user/.gitkeep
assets/models/tmp

# Local-only models: keep directory traversal open for Markdown notes, but
# ignore every other file type (models, textures, audio, archives, etc.).
/assets/models/local/**
!/assets/models/local/**/
!/assets/models/local/**/*.md
!/assets/models/local/**/*.MD
!/assets/models/local/**/*.markdown
!/assets/models/local/**/*.MARKDOWN

# Personal examples stay local; Git needs one tracked file to retain the folder.
/examples/local/**
!/examples/local/.gitkeep

# Texture compression CLIs installed by scripts/install-texture-tools
/tools/texture/
