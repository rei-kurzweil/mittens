/target
/.games/
.vscode
vendor-openxr/

# Profiling artifacts
docs/analysis/perf.data*
docs/.debug/*.log

# World panel save output. The directory itself is tracked via data/.gitkeep
# so the default `io_working_dir` resolves without manual setup.
/data/*
!/data/.gitkeep
assets/models/tmp

# Local-only models: keep directory traversal open for Markdown notes, but
# ignore every other file type (models, textures, audio, archives, etc.).
/assets/models/local/**
!/assets/models/local/**/
!/assets/models/local/**/*.md
!/assets/models/local/**/*.MD
!/assets/models/local/**/*.markdown
!/assets/models/local/**/*.MARKDOWN

# Personal examples stay local; Git needs one tracked file to retain the folder.
/examples/local/**
!/examples/local/.gitkeep
