// Shared VRoid/VRM-style humanoid landmark convention.
export fn vroid_humanoid_bone_map() {
    return HumanoidBoneMap.new()
        .slot("hips", "[name='J_Bip_C_Hips']")
        .slot("left_upper_leg", "[name='J_Bip_L_UpperLeg']")
        .slot("left_lower_leg", "[name='J_Bip_L_LowerLeg']")
        .slot("left_foot", "[name='J_Bip_L_Foot']")
        .slot("right_upper_leg", "[name='J_Bip_R_UpperLeg']")
        .slot("right_lower_leg", "[name='J_Bip_R_LowerLeg']")
        .slot("right_foot", "[name='J_Bip_R_Foot']")
        .slot("neck", "[name='J_Bip_C_Neck']")
        .slot("head", "[name='J_Bip_C_Head']")
        .slot("left_eye", "[name='J_Adj_L_FaceEye']")
        .slot("right_eye", "[name='J_Adj_R_FaceEye']")
        .slot("left_upper_arm", "[name='J_Bip_L_UpperArm']")
        .slot("left_lower_arm", "[name='J_Bip_L_LowerArm']")
        .slot("left_hand", "[name='J_Bip_L_Hand']")
        .slot("right_upper_arm", "[name='J_Bip_R_UpperArm']")
        .slot("right_lower_arm", "[name='J_Bip_R_LowerArm']")
        .slot("right_hand", "[name='J_Bip_R_Hand']")
        .slot("left_thumb_metacarpal", "[name='J_Bip_L_Thumb1']")
        .slot("left_thumb_proximal", "[name='J_Bip_L_Thumb2']")
        .slot("left_thumb_distal", "[name='J_Bip_L_Thumb3']")
        .slot("left_index_proximal", "[name='J_Bip_L_Index1']")
        .slot("left_index_intermediate", "[name='J_Bip_L_Index2']")
        .slot("left_index_distal", "[name='J_Bip_L_Index3']")
        .slot("left_middle_proximal", "[name='J_Bip_L_Middle1']")
        .slot("left_middle_intermediate", "[name='J_Bip_L_Middle2']")
        .slot("left_middle_distal", "[name='J_Bip_L_Middle3']")
        .slot("left_ring_proximal", "[name='J_Bip_L_Ring1']")
        .slot("left_ring_intermediate", "[name='J_Bip_L_Ring2']")
        .slot("left_ring_distal", "[name='J_Bip_L_Ring3']")
        .slot("left_little_proximal", "[name='J_Bip_L_Little1']")
        .slot("left_little_intermediate", "[name='J_Bip_L_Little2']")
        .slot("left_little_distal", "[name='J_Bip_L_Little3']")
        .slot("right_thumb_metacarpal", "[name='J_Bip_R_Thumb1']")
        .slot("right_thumb_proximal", "[name='J_Bip_R_Thumb2']")
        .slot("right_thumb_distal", "[name='J_Bip_R_Thumb3']")
        .slot("right_index_proximal", "[name='J_Bip_R_Index1']")
        .slot("right_index_intermediate", "[name='J_Bip_R_Index2']")
        .slot("right_index_distal", "[name='J_Bip_R_Index3']")
        .slot("right_middle_proximal", "[name='J_Bip_R_Middle1']")
        .slot("right_middle_intermediate", "[name='J_Bip_R_Middle2']")
        .slot("right_middle_distal", "[name='J_Bip_R_Middle3']")
        .slot("right_ring_proximal", "[name='J_Bip_R_Ring1']")
        .slot("right_ring_intermediate", "[name='J_Bip_R_Ring2']")
        .slot("right_ring_distal", "[name='J_Bip_R_Ring3']")
        .slot("right_little_proximal", "[name='J_Bip_R_Little1']")
        .slot("right_little_intermediate", "[name='J_Bip_R_Little2']")
        .slot("right_little_distal", "[name='J_Bip_R_Little3']")
}
